# Copy to .env.local when connecting a Supabase project.
# Public pages and the read-only setup preview work without these values.
# Officer login and published settings require the Supabase migration and accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC or commit .env.local.
SUPABASE_SECRET_KEY=
# Generate a random secret of at least 32 characters; used to hash rate-limit identifiers.
APPLICATION_RATE_LIMIT_SECRET=
